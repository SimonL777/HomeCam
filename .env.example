# Address advertised to WebRTC clients. Replace it with the server LAN IP.
NAS_IP=192.168.50.10
WEB_PORT=8095
TZ=UTC

# Dashboard credentials. Use a long, unique password.
WEB_USERNAME=homecam
WEB_PASSWORD=replace-with-a-long-random-password

# Raspberry Pi RTSP publisher credentials.
RTSP_PUBLISH_USER=camera-publisher
RTSP_PUBLISH_PASSWORD=replace-with-a-random-hex-password

# Internal secret shared only by MediaMTX and the web container.
HLS_CDN_SECRET=replace-with-a-random-64-character-secret

# Optional camera settings controller on the Raspberry Pi.
PI_CONTROL_URL=http://192.168.50.11:9110
PI_CONTROL_TOKEN=

# Internal AI control-plane token. Generate it with: openssl rand -hex 32
AI_ORCHESTRATOR_TOKEN=replace-with-a-random-64-character-secret

# The AI API binds to localhost by default. Set this to the NAS LAN or VPN IP
# only when a remote GPU worker needs to register, and protect the port with a firewall.
AI_BIND_ADDRESS=127.0.0.1
AI_PORT=8090
AI_LEASE_MS=30000
AI_WORKER_OFFLINE_MS=30000
AI_RETRY_BASE_MS=1000

# Optional generic external worker configuration. Keep these unset unless the
# worker runs with WORKER_RUNTIME=http-json on a trusted host.
# EXTERNAL_PROVIDER_URL=https://provider.example/v1/homecam/infer
# EXTERNAL_PROVIDER_TOKEN=replace-with-provider-token
